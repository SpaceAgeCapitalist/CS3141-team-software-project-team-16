<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.spaceage_capitalist.QuizEditorController">
   <top>
      <Label fx:id="titleLabel" style="-fx-font-size: 24px;" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20.0" bottom="10.0" />
         </padding>
      </Label>
   </top>
   <center>
      <ScrollPane fitToWidth="true">
         <content>
            <VBox fx:id="questionContainer" spacing="15.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Button text="Add Question" onAction="#addQuestion" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Cancel" onAction="#cancel" />
            <Button text="Save Quiz" onAction="#saveQuiz" />
         </children>
      </HBox>
   </bottom>
</BorderPane>